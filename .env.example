# Runtime
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
DATABASE_URL=postgres://kuya_dars:kuya_dars@localhost:5432/kuya_dars
DATABASE_SSL=false
TRUST_PROXY=false

# Required to seed the first owner. Use a unique password; never commit it.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Local uploads are development-only. Production startup rejects this driver.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./private-uploads
MAX_UPLOAD_BYTES=5242880
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email is queued and retried. "console" is development-only and sends nothing.
NOTIFICATION_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
MANAGER_EMAIL=

# Optional deterministic demo tracker generation (development only).
DEMO_TRACKING_SECRET=replace-with-a-development-only-secret

# Optional: configure only after the merchant approves the QR asset.
GCASH_MERCHANT_NAME=
